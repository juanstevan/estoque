generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TransactionType {
  RECEIVED
  SOLD
  RESERVED
  RELEASED
  PICKED_UP
  DELIVERED
  ADJUSTMENT
  CORRECTION
  RETURNED
  TRANSFER
  IMPORTATION
}

enum ImportationStatus {
  DRAFT
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  OPEN
  PARTIALLY_PICKED
  READY_PICKUP
  READY_DELIVERY
  COMPLETED
  CANCELLED
}

model Product {
  id                String   @id @default(cuid())
  name              String
  sku               String   @unique
  secondarySku      String?
  ean               String?
  imageUrl          String?
  b2bPrice          Float    @default(0)
  b2cPrice          Float    @default(0)
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  notes             String?
  physicalQty       Float    @default(0)
  availableQty      Float    @default(0)
  reservedQty       Float    @default(0)
  waitingPickupQty  Float    @default(0)
  waitingDeliveryQty Float   @default(0)
  unavailableQty    Float    @default(0)
  avgCost           Float    @default(0)
  inventoryValue    Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      InventoryTransaction[]
  costHistory       CostHistory[]
  importationLines  ImportationLine[]
  orderLines        OrderLine[]

  @@index([name])
  @@index([ean])
  @@index([secondarySku])
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  productId   String
  type        TransactionType
  quantity    Float
  unitCost    Float           @default(0)
  totalValue  Float           @default(0)
  reference   String?
  notes       String?
  userId      String          @default("demo")
  occurredAt  DateTime        @default(now())
  metadata    String?
  createdAt   DateTime        @default(now())

  product     Product         @relation(fields: [productId], references: [id])
  costHistory CostHistory?

  @@index([productId, occurredAt])
  @@index([type])
  @@index([reference])
}

model CostHistory {
  id               String   @id @default(cuid())
  productId        String
  transactionId    String   @unique
  eventType        String
  quantityDelta    Float
  unitCost         Float
  resultingAvgCost Float
  resultingQty     Float
  resultingValue   Float
  occurredAt       DateTime @default(now())

  product          Product              @relation(fields: [productId], references: [id])
  transaction      InventoryTransaction @relation(fields: [transactionId], references: [id])

  @@index([productId, occurredAt])
}

model Importation {
  id                   String            @id @default(cuid())
  reference            String            @unique
  status               ImportationStatus @default(DRAFT)
  expectedDate         DateTime?
  notes                String?
  freightIntl          Float             @default(0)
  customs              Float             @default(0)
  brokerFees           Float             @default(0)
  portFees             Float             @default(0)
  freightDomestic      Float             @default(0)
  otherCosts           Float             @default(0)
  productSubtotal      Float             @default(0)
  totalAdditionalCosts Float             @default(0)
  createdBy            String            @default("demo")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  receivedAt           DateTime?

  lines                ImportationLine[]
}

model ImportationLine {
  id                     String  @id @default(cuid())
  importationId          String
  productId              String?
  draftName              String?
  draftSku               String?
  draftEan               String?
  quantity               Float
  purchaseUnitCost       Float   @default(0)
  allocatedAdditionalCost Float  @default(0)
  landedUnitCost         Float   @default(0)
  weight                 Float?
  length                 Float?
  width                  Float?
  height                 Float?
  notes                  String?

  importation            Importation @relation(fields: [importationId], references: [id], onDelete: Cascade)
  product                Product?    @relation(fields: [productId], references: [id])

  @@index([importationId])
}

model Order {
  id          String      @id @default(cuid())
  externalRef String      @unique
  customerName String?
  status      OrderStatus @default(OPEN)
  source      String      @default("manual")
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines       OrderLine[]
}

model OrderLine {
  id            String @id @default(cuid())
  orderId       String
  productId     String
  orderedQty    Float
  reservedQty   Float  @default(0)
  pickedQty     Float  @default(0)
  waitingPickupQty Float @default(0)
  deliveredQty  Float  @default(0)
  remainingQty  Float  @default(0)

  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model QbSyncEvent {
  id          String   @id @default(cuid())
  eventType   String
  externalId  String?
  payload     String
  processed   Boolean  @default(false)
  processedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
}
