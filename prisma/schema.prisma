generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  RECEIVED
  SOLD
  RESERVED
  RELEASED
  PICKED_UP
  DELIVERED
  ADJUSTMENT
  CORRECTION
  RETURNED
  TRANSFER
  IMPORTATION
}

enum ImportKind {
  DOMESTIC
  INTERNATIONAL
}

enum ImportStatus {
  PENDING
  IN_TRANSIT
  DELAYED
  COMPLETED
}

enum ExitStatus {
  PENDING
  PREPARING
  IN_TRANSIT
  TO_DELIVER
  DELAYED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  assignedTasks Task[]
}

model AppSettings {
  id                 String @id @default("default")
  companyName        String @default("Chaleur Manufacturing Co.")
  logoUrl            String?
  adjustmentReasons  String @default("[\"Correction\",\"Adjust\",\"Return\",\"Warranty\"]")
  yearColors         String @default("{\"2024\":\"#22c55e\",\"2025\":\"#3b82f6\",\"2026\":\"#ef4444\",\"2027\":\"#a855f7\"}")
  importColumns      String @default("[]")
}

model Supplier {
  id   String @id @default(cuid())
  name String @unique
}

model Product {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  sku                String   @unique
  type               String?
  category           String?
  model              String?
  hsCode             String?
  secondarySku       String?
  ean                String?
  amazonUrl          String?
  imageUrl           String?
  b2bPrice           Float    @default(0)
  b2cPrice           Float    @default(0)
  fobCost            Float    @default(0)
  cifCost            Float    @default(0)
  lastSoldPrice      Float    @default(0)
  suppliers          String?
  weight             Float?
  length             Float?
  width              Float?
  height             Float?
  packageLength      Float?
  packageWidth       Float?
  packageHeight      Float?
  packageWeight      Float?
  cutoutLength       Float?
  cutoutWidth        Float?
  cutoutHeight       Float?
  notes              String?
  physicalQty        Float    @default(0)
  availableQty       Float    @default(0)
  reservedQty        Float    @default(0)
  waitingPickupQty   Float    @default(0)
  waitingDeliveryQty Float    @default(0)
  unavailableQty     Float    @default(0)
  avgCost            Float    @default(0)
  inventoryValue     Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions     InventoryTransaction[]
  costHistory      CostHistory[]
  importationLines ImportationLine[]
  orderLines       OrderLine[]
  photos           ProductPhoto[]
  groupId          String?
  group            MediaGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([ean])
  @@index([groupId])
}

/** Read-only media link. Neither id set = every product. */
model PhotoShare {
  token     String   @id
  productId String?  @unique
  groupId   String?  @unique
  createdAt DateTime @default(now())
}

/** Products in a group (and its subgroups) inherit its photos and files. */
model MediaGroup {
  id        String         @id @default(cuid())
  name      String
  brand     String?
  parentId  String?
  position  Float          @default(0)
  createdAt DateTime       @default(now())
  parent    MediaGroup?    @relation("MediaGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaGroup[]   @relation("MediaGroupTree")
  products  Product[]
  assets    ProductPhoto[]

  @@index([parentId, position])
}

/** A photo or file owned by exactly one product or one group. */
model ProductPhoto {
  id           String      @id @default(cuid())
  productId    String?
  groupId      String?
  kind         String      @default("photo")
  url          String
  thumbUrl     String
  tag          String      @default("")
  fileName     String      @default("")
  originalName String      @default("")
  contentType  String      @default("image/jpeg")
  size         Int         @default(0)
  width        Int?
  height       Int?
  position     Float       @default(0)
  createdAt    DateTime    @default(now())
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  group        MediaGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([groupId, position])
}

model InventoryTransaction {
  id         String          @id @default(cuid())
  productId  String
  type       TransactionType
  quantity   Float
  unitCost   Float           @default(0)
  totalValue Float           @default(0)
  reference  String?
  notes      String?
  clientName String?
  userId     String          @default("demo")
  occurredAt DateTime        @default(now())
  metadata   String?
  createdAt  DateTime        @default(now())

  product     Product      @relation(fields: [productId], references: [id])
  costHistory CostHistory?

  @@index([productId, occurredAt])
  @@index([type])
  @@index([reference])
}

model CostHistory {
  id               String   @id @default(cuid())
  productId        String
  transactionId    String   @unique
  eventType        String
  quantityDelta    Float
  unitCost         Float
  resultingAvgCost Float
  resultingQty     Float
  resultingValue   Float
  occurredAt       DateTime @default(now())

  product     Product              @relation(fields: [productId], references: [id])
  transaction InventoryTransaction @relation(fields: [transactionId], references: [id])

  @@index([productId, occurredAt])
}

model Importation {
  id                   String       @id @default(cuid())
  reference            String       @unique
  kind                 ImportKind   @default(INTERNATIONAL)
  status               ImportStatus @default(PENDING)
  supplierName         String?
  expectedDate         DateTime?
  notes                String?
  transferFee          Float        @default(0)
  freight              Float        @default(0)
  delivery             Float        @default(0)
  duties               Float        @default(0)
  customs              Float        @default(0)
  otherCosts           Float        @default(0)
  productSubtotal      Float        @default(0)
  totalAdditionalCosts Float        @default(0)
  coefficient          Float        @default(1)
  createdBy            String       @default("demo")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  receivedAt           DateTime?
  delayOverridden      Boolean      @default(false)

  lines ImportationLine[]
}

model ImportationLine {
  id                      String  @id @default(cuid())
  importationId           String
  productId               String?
  draftName               String?
  draftSku                String?
  quantity                Float
  purchaseUnitCost        Float   @default(0)
  allocatedAdditionalCost Float   @default(0)
  landedUnitCost          Float   @default(0)
  notes                   String?

  importation Importation @relation(fields: [importationId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([importationId])
}

model Order {
  id           String     @id @default(cuid())
  externalRef  String     @unique
  customerName String?
  seller       String?
  assignedTo   String?
  address      String?
  deliverBy    DateTime?
  status       ExitStatus @default(PENDING)
  onKanban     Boolean    @default(false)
  source       String     @default("invoice")
  notes        String?
  photos       String?
  totalAmount  Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  lines OrderLine[]
}

model OrderLine {
  id               String @id @default(cuid())
  orderId          String
  productId        String
  orderedQty       Float
  reservedQty      Float  @default(0)
  pickedQty        Float  @default(0)
  waitingPickupQty Float  @default(0)
  deliveredQty     Float  @default(0)
  remainingQty     Float  @default(0)
  unitPrice        Float  @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model QbSyncEvent {
  id          String    @id @default(cuid())
  eventType   String
  externalId  String?
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model TaskBoard {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lists     TaskList[]
}

model TaskList {
  id       String    @id @default(cuid())
  boardId  String
  title    String
  color    String    @default("#5b6472")
  position Float
  board    TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId, position])
}

model Task {
  id          String    @id @default(cuid())
  listId      String
  title       String
  description String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  /// none | low | medium | high
  priority    String    @default("none")
  /// JSON [{ name, color }]
  labels      String    @default("[]")
  assigneeId  String?
  /// JSON [{ id, name, url, size }]
  attachments String    @default("[]")
  position    Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  list        TaskList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]

  @@index([listId, position])
  @@index([assigneeId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Sale {
  id       String   @id @default(cuid())
  date     String
  invoice  String
  client   String
  seller   String
  sku      String   @default("")
  item     String
  qty      Float
  price    Float
  total    Float
  syncedAt DateTime @default(now())

  @@unique([invoice, sku])
  @@index([date])
}
