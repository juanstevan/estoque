generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  RECEIVED
  SOLD
  RESERVED
  RELEASED
  PICKED_UP
  DELIVERED
  ADJUSTMENT
  CORRECTION
  RETURNED
  TRANSFER
  IMPORTATION
}

enum ImportKind {
  DOMESTIC
  INTERNATIONAL
}

enum ImportStatus {
  PENDING
  IN_TRANSIT
  DELAYED
  COMPLETED
}

enum ExitStatus {
  PENDING
  PREPARING
  IN_TRANSIT
  TO_DELIVER
  DELAYED
  COMPLETED
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  name               String
  passwordHash       String
  /// Legacy label from before roles. Access comes from roleId.
  role               String     @default("admin")
  roleId             String?
  /// Set for a temporary password: they choose their own on the next sign-in.
  mustChangePassword Boolean    @default(false)
  deactivatedAt      DateTime?
  lastSignInAt       DateTime?
  /// Wrong passwords in a row; the account pauses for a few minutes after 5.
  failedSignIns      Int        @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime   @default(now())
  access             Role?      @relation(fields: [roleId], references: [id])
  assignedTasks      Task[]
  sessions           Session[]
  deliveries         Delivery[]
}

/** What a role can open. The main role always has full access and manages people, roles and hidden tabs. */
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  /// JSON { storage, media, imports, delivery, tasks, reports, settings: "none" | "view" | "edit" }
  access      String   @default("{}")
  main        Boolean  @default(false)
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  users       User[]
}

/** The cookie holds a random token; only its SHA-256 is stored. */
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSettings {
  id                 String @id @default("default")
  companyName        String @default("Chaleur Manufacturing Co.")
  logoUrl            String?
  adjustmentReasons  String @default("[\"Correction\",\"Adjust\",\"Return\",\"Warranty\"]")
  yearColors         String @default("{\"2024\":\"#22c55e\",\"2025\":\"#3b82f6\",\"2026\":\"#ef4444\",\"2027\":\"#a855f7\"}")
  importColumns      String @default("[]")
  brandColor         String?
  accentColor        String?
  qbClientId         String?
  qbClientSecret     String?
  qbRealmId          String?
  qbRedirectUri      String?
  qbRefreshToken     String?
  qbAccessToken      String?
  qbAccessExpires    DateTime?
  qbSyncAt           DateTime?
  qbSyncedAt         DateTime?
  qbSyncError        String?
  companyPhone       String?
  /// JSON array of tab ids hidden for everyone. Storage can't be hidden.
  hiddenTabs         String @default("[\"tasks\",\"reports\"]")
  /// When a delivery's units leave stock: ready | out | completed
  stockStage         String @default("completed")
  allowPaid          Boolean @default(true)
  allowUnpaid        Boolean @default(true)
  /// Unpaid invoices may still go out as collections (paid at pickup).
  collectUnpaid      Boolean @default(true)
  /// How preparation is checked: manual (type quantities) | scan
  prepMethod         String @default("manual")
  /// A tracking link stops working this many days after the last delivery.
  trackingDays       Int    @default(7)
}

model Supplier {
  id   String @id @default(cuid())
  name String @unique
}

model Product {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  sku                String   @unique
  type               String?
  category           String?
  model              String?
  hsCode             String?
  secondarySku       String?
  ean                String?
  amazonUrl          String?
  imageUrl           String?
  b2bPrice           Float    @default(0)
  b2cPrice           Float    @default(0)
  fobCost            Float    @default(0)
  cifCost            Float    @default(0)
  lastSoldPrice      Float    @default(0)
  suppliers          String?
  weight             Float?
  length             Float?
  width              Float?
  height             Float?
  packageLength      Float?
  packageWidth       Float?
  packageHeight      Float?
  packageWeight      Float?
  cutoutLength       Float?
  cutoutWidth        Float?
  cutoutHeight       Float?
  notes              String?
  physicalQty        Float    @default(0)
  availableQty       Float    @default(0)
  reservedQty        Float    @default(0)
  waitingPickupQty   Float    @default(0)
  waitingDeliveryQty Float    @default(0)
  unavailableQty     Float    @default(0)
  avgCost            Float    @default(0)
  inventoryValue     Float    @default(0)
  qbUpdatedAt        DateTime?
  /// QuickBooks name, SKU and price as last seen or pushed (JSON)
  qbSeen             String?
  /// Catalog visibility: the variant row, and the model fields when the product has no Tag (JSON)
  catalogFields      String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions     InventoryTransaction[]
  costHistory      CostHistory[]
  importationLines ImportationLine[]
  orderLines       OrderLine[]
  photos           ProductPhoto[]
  groupId          String?
  group            MediaGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tagId            String?
  tag              Tag?                   @relation(fields: [tagId], references: [id], onDelete: SetNull)
  mediaLinks       MediaLink[]

  @@index([name])
  @@index([ean])
  @@index([groupId])
  @@index([tagId])
}

/** Read-only media link. Neither id set = every product. */
model PhotoShare {
  token     String   @id
  productId String?  @unique
  groupId   String?  @unique
  createdAt DateTime @default(now())
}

/** Products in a group (and its subgroups) inherit its photos and files. */
model MediaGroup {
  id        String         @id @default(cuid())
  name      String
  brand     String?
  parentId  String?
  position  Float          @default(0)
  createdAt DateTime       @default(now())
  parent    MediaGroup?    @relation("MediaGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaGroup[]   @relation("MediaGroupTree")
  products  Product[]
  assets    ProductPhoto[]

  @@index([parentId, position])
}

/** A photo or file. It can sit in the library with no owner, or belong to a product or group. */
model ProductPhoto {
  id           String      @id @default(cuid())
  productId    String?
  groupId      String?
  kind         String      @default("photo")
  url          String
  thumbUrl     String
  tag          String      @default("")
  fileName     String      @default("")
  originalName String      @default("")
  contentType  String      @default("image/jpeg")
  size         Int         @default(0)
  width        Int?
  height       Int?
  position     Float       @default(0)
  /// Who may see it outside the app: internal | partners | public
  visibility   String      @default("internal")
  createdAt    DateTime    @default(now())
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  group        MediaGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  links        MediaLink[]

  @@index([productId, position])
  @@index([groupId, position])
}

model Tag {
  id       String      @id @default(cuid())
  name     String      @unique
  color    String
  /// Who sees each catalog field of this model, JSON { field: internal | partners | public }
  catalogFields String @default("{}")
  products Product[]
  links    MediaLink[]
}

/** One file, many connections. A product sees a file when any connection matches it. */
model MediaLink {
  id        String       @id @default(cuid())
  photoId   String
  productId String?
  tagId     String?
  brand     String?
  category  String?
  family    String?
  /// "cover": the cover of the brand, category, family or tag it links to
  role      String?
  photo     ProductPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag?         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([productId])
  @@index([tagId])
}

model InventoryTransaction {
  id         String          @id @default(cuid())
  productId  String
  type       TransactionType
  quantity   Float
  unitCost   Float           @default(0)
  totalValue Float           @default(0)
  reference  String?
  notes      String?
  clientName String?
  userId     String          @default("demo")
  occurredAt DateTime        @default(now())
  metadata   String?
  createdAt  DateTime        @default(now())

  product     Product      @relation(fields: [productId], references: [id])
  costHistory CostHistory?

  @@index([productId, occurredAt])
  @@index([type])
  @@index([reference])
}

model CostHistory {
  id               String   @id @default(cuid())
  productId        String
  transactionId    String   @unique
  eventType        String
  quantityDelta    Float
  unitCost         Float
  resultingAvgCost Float
  resultingQty     Float
  resultingValue   Float
  occurredAt       DateTime @default(now())

  product     Product              @relation(fields: [productId], references: [id])
  transaction InventoryTransaction @relation(fields: [transactionId], references: [id])

  @@index([productId, occurredAt])
}

model Importation {
  id                   String       @id @default(cuid())
  reference            String       @unique
  kind                 ImportKind   @default(INTERNATIONAL)
  status               ImportStatus @default(PENDING)
  supplierName         String?
  expectedDate         DateTime?
  notes                String?
  transferFee          Float        @default(0)
  freight              Float        @default(0)
  delivery             Float        @default(0)
  duties               Float        @default(0)
  customs              Float        @default(0)
  otherCosts           Float        @default(0)
  productSubtotal      Float        @default(0)
  totalAdditionalCosts Float        @default(0)
  coefficient          Float        @default(1)
  createdBy            String       @default("demo")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  receivedAt           DateTime?
  delayOverridden      Boolean      @default(false)

  lines ImportationLine[]
}

model ImportationLine {
  id                      String  @id @default(cuid())
  importationId           String
  productId               String?
  draftName               String?
  draftSku                String?
  quantity                Float
  purchaseUnitCost        Float   @default(0)
  allocatedAdditionalCost Float   @default(0)
  landedUnitCost          Float   @default(0)
  notes                   String?

  importation Importation @relation(fields: [importationId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([importationId])
}

/**
 * A QuickBooks invoice. Its deliveries carry the workflow; status and completedAt here sum
 * them up (COMPLETED once every delivery is). onKanban means it was added to the workflow.
 */
model Order {
  id           String     @id @default(cuid())
  externalRef  String     @unique
  customerName String?
  seller       String?
  /// Legacy (before deliveries): assignedTo, deliverBy, mode, priorStatus, completedBy,
  /// delayReason, customerNote, revisedDate, dispatchedAt, windowNote. Deliveries own these now.
  assignedTo   String?
  address      String?
  deliverBy    DateTime?
  status       ExitStatus @default(PENDING)
  onKanban     Boolean    @default(false)
  source       String     @default("invoice")
  notes        String?
  photos       String?
  totalAmount  Float      @default(0)
  amountPaid   Float      @default(0)
  taxAmount    Float      @default(0)
  customerPhone String?
  qbCustomerId String?
  invoiceDate  DateTime?
  mode         String     @default("DELIVERY")
  qbRealmId    String?
  qbInvoiceId  String?
  qbUpdatedAt  DateTime?
  qbAddress    String?
  priorStatus  ExitStatus?
  completedAt  DateTime?
  completedBy  String?
  delayReason  String?
  customerNote String?
  revisedDate  DateTime?
  trackingToken String?   @unique
  trackingExpiresAt DateTime?
  voided       Boolean    @default(false)
  issues       String?
  paymentStatus String?
  dispatchedAt DateTime?
  windowNote   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  lines      OrderLine[]
  events     OrderEvent[]
  proofs     OrderProof[]
  deliveries Delivery[]

  @@unique([qbRealmId, qbInvoiceId])
}

/** One trip (or pickup) for part or all of an invoice. Most invoices have exactly one. */
model Delivery {
  id           String      @id @default(cuid())
  orderId      String
  number       Int         @default(1)
  status       ExitStatus  @default(PENDING)
  /// DELIVERY | PICKUP (shown as Collect)
  mode         String      @default("DELIVERY")
  assigneeId   String?
  deliverBy    DateTime?
  /// "HH:MM", New York time
  windowStart  String?
  windowEnd    String?
  priorStatus  ExitStatus?
  delayReason  String?
  dispatchedAt DateTime?
  /// When this delivery's units left stock (at the stage set in Preferences).
  stockOutAt   DateTime?
  completedAt  DateTime?
  completedBy  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignee User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  lines    DeliveryLine[]
  proofs   OrderProof[]

  @@unique([orderId, number])
  @@index([deliverBy])
  @@index([assigneeId])
}

model DeliveryLine {
  id          String    @id @default(cuid())
  deliveryId  String
  orderLineId String
  qty         Float
  /// Scanned or typed during preparation.
  preparedQty Float     @default(0)
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, orderLineId])
  @@index([orderLineId])
}

model OrderLine {
  id               String @id @default(cuid())
  orderId          String
  productId        String
  orderedQty       Float
  reservedQty      Float  @default(0)
  pickedQty        Float  @default(0)
  waitingPickupQty Float  @default(0)
  deliveredQty     Float  @default(0)
  remainingQty     Float  @default(0)
  unitPrice        Float  @default(0)
  scannedQty       Float  @default(0)
  physical         Boolean @default(true)

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id])
  deliveries DeliveryLine[]

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  kind      String
  message   String
  actor     String
  public    Boolean  @default(false)
  meta      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderProof {
  id         String    @id @default(cuid())
  orderId    String
  deliveryId String?
  url        String
  kind       String
  public     Boolean   @default(false)
  actor      String
  createdAt  DateTime  @default(now())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([deliveryId])
}

model QbSyncEvent {
  id          String    @id @default(cuid())
  eventType   String
  externalId  String?
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model TaskBoard {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lists     TaskList[]
}

model TaskList {
  id       String    @id @default(cuid())
  boardId  String
  title    String
  color    String    @default("#5b6472")
  position Float
  board    TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId, position])
}

model Task {
  id          String    @id @default(cuid())
  listId      String
  title       String
  description String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  /// none | low | medium | high
  priority    String    @default("none")
  /// JSON [{ name, color }]
  labels      String    @default("[]")
  assigneeId  String?
  /// JSON [{ id, name, url, size }]
  attachments String    @default("[]")
  position    Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  list        TaskList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]

  @@index([listId, position])
  @@index([assigneeId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Sale {
  id       String   @id @default(cuid())
  date     String
  invoice  String
  client   String
  seller   String
  sku      String   @default("")
  item     String
  qty      Float
  price    Float
  total    Float
  syncedAt DateTime @default(now())

  @@unique([invoice, sku])
  @@index([date])
}

/// A shareable catalog for one brand. The audience decides which fields and files it shows.
model CatalogLink {
  token     String    @id
  brand     String
  audience  String    @default("partners")
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([brand, audience])
}
